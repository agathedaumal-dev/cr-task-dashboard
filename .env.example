# Shared papernest Clerk instance — request keys from the platform team.
# Do NOT create a new Clerk project.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

CLERK_JWT_KEY=

# ⚠️  CLERK_SECRET_KEY is intentionally set to an invalid placeholder.
# The @clerk/nextjs SDK requires this variable to initialize, but JWT verification
# is handled entirely by CLERK_JWT_KEY above. This placeholder has no admin privileges.
# DO NOT replace this with a real Clerk secret key — business apps must remain least-privileged.
# Any accidental call to clerkClient / currentUser() will fail with an auth error (by design).
CLERK_SECRET_KEY=INTENTIONALLY_INVALID_DO_NOT_REPLACE

# The route at which your authentication flow lives, for more information see: https://clerk.com/docs/deployments/clerk-environment-variables
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Redirect URLs for after authenticating, for more information see: https://clerk.com/docs/guides/custom-redirects
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/

# The unique key used to verify user access.
APP_IDENTIFIER=template_placeholder

# PostgreSQL credentials — used by docker-compose.yml to create the local database.
# Must match the credentials in DATABASE_URL below.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# PostgreSQL connection string (optional — only needed if the app uses a database).
# Local (docker compose up, Next.js on host): postgresql://<user>:<password>@localhost:5433/<db>
# Local (everything in Docker):              postgresql://<user>:<password>@postgres:5432/<db>
# Production:                                injected by infra from the shared RDS instance
# Note: port 5433 avoids conflict with a local PostgreSQL installation on port 5432.
# DATABASE_URL=postgresql://<user>:<password>@localhost:5433/<db>