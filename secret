#!/usr/bin/env bash
#
# secret — manage your app's secrets without touching any encryption. Run from your app repo root.
# (Copied in as ./secret during onboarding.)
#
#   ./secret set KEY [value]    add or update a secret (asks for the value if omitted, typed hidden)
#   ./secret remove KEY         delete a secret
#   ./secret list               list secret NAMES (you can't read the values — they're encrypted)
#
# Or just ask your AI assistant, e.g. "set a secret STRIPE_SECRET_KEY" / "remove secret X".
#
# How it works: each secret is encrypted on its own with the platform's PUBLIC key into
# infra_platform/secrets/<KEY>.age and committed. You can add/update/remove without ever
# decrypting, so you never need a private key or AWS access. On the next push, the platform
# (which alone holds the private key) decrypts and injects it into your app as an env var.
#
set -euo pipefail

DIR="infra_platform/secrets"
REC=".secret-recipient"

die() { echo "❌ $*" >&2; exit 1; }
usage() {
  cat >&2 <<'EOF'
Usage:
  ./secret set KEY [value]   add or update a secret
  ./secret remove KEY        delete a secret
  ./secret list              list secret names (values stay encrypted)
EOF
  exit 1
}

CMD="${1:-}"
KEY="${2:-}"

[[ -f "$REC" ]] || die "Missing $REC (the platform public key) — run from your app repo root. See SECRETS.md."

need_age() {
  command -v age >/dev/null 2>&1 && return
  command -v brew >/dev/null 2>&1 || die "'age' isn't installed and can't be auto-installed here — see SECRETS.md."
  echo "Installing age…"
  brew install age
}

recipient="$(tr -d '[:space:]' <"$REC")"
[[ "$recipient" == age1* ]] || die "$REC doesn't contain a valid age public key yet — ask DevOps (bootstrap pending)."

case "$CMD" in
  set)
    [[ -n "$KEY" ]] || usage
    need_age
    val="${3:-}"
    if [[ -z "$val" ]]; then read -r -s -p "Value for ${KEY}: " val; echo; fi
    [[ -n "$val" ]] || die "No value given."
    mkdir -p "$DIR"
    printf '%s' "$val" | age -r "$recipient" -o "$DIR/${KEY}.age"
    git add "$DIR/${KEY}.age"
    git commit -q -m "secret: set ${KEY}"
    git push -q
    echo "✅ Saved ${KEY}. Your app will use it within ~1–2 minutes."
    ;;
  remove | rm | delete)
    [[ -n "$KEY" ]] || usage
    [[ -f "$DIR/${KEY}.age" ]] || die "No secret named ${KEY}."
    git rm -q "$DIR/${KEY}.age"
    git commit -q -m "secret: remove ${KEY}"
    git push -q
    echo "✅ Removed ${KEY}. Your app will stop receiving it within ~1–2 minutes."
    ;;
  list | ls)
    if compgen -G "$DIR/*.age" >/dev/null 2>&1; then
      echo "Secrets set for this app (names only — values are encrypted):"
      for f in "$DIR"/*.age; do echo "  - $(basename "$f" .age)"; done
    else
      echo "(no secrets set)"
    fi
    ;;
  *) usage ;;
esac
